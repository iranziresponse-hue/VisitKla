{
  "name": "visitkla",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "expo:web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "seed:generate": "node scripts/generate-seed-sql.js",
    "sync:web": "node scripts/sync-web-data.js",
    "web:dev": "npm run sync:web && npm --prefix web run dev",
    "web:build": "npm run sync:web && npm --prefix web run build",
    "web:typecheck": "npm --prefix web run typecheck"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "^10.0.11",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@supabase/supabase-js": "^2.45.4",
    "expo": "~51.0.28",
    "expo-constants": "~16.0.2",
    "expo-location": "~17.0.1",
    "expo-speech": "~12.0.2",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-url-polyfill": "^2.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.2.79",
    "typescript": "~5.3.3"
  }
}
