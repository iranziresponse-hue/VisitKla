# Optional — VisitKla web works fully offline with bundled seed data.
# Fill these in only if you want it to sync from a real Supabase project.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# WhatsApp number the "This is wrong?" report button messages (with country code, no +)
VITE_REPORT_WHATSAPP_NUMBER=256700000000
